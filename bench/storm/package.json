{
  "name": "@bugbusterhq/bench-storm",
  "version": "0.0.0",
  "private": true,
  "description": "Error-storm benchmark: BugBuster vs a standard OpenTelemetry exporter, same storm, same collector.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf -g dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "storm": "node dist/run.js"
  },
  "dependencies": {
    "@bugbusterhq/agent": "workspace:*",
    "@bugbusterhq/sdk-node": "workspace:*",
    "@bugbusterhq/types": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1"
  }
}
